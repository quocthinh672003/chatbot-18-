# Environment variables for AI Chat System

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=86400

# Venice LLM Configuration
VENICE_BASE_URL=http://localhost:8001
VENICE_API_KEY=your-venice-api-key
VENICE_MODEL=gpt-3.5-turbo

# Memory Configuration
MAX_TOKEN_LIMIT=2000
TEMPERATURE=0.5
MEMORY_K=5  # Giữ k message gần nhất

# App Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True



